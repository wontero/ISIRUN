@{
    ViewData["Title"] = "Entrar";
    ViewData["Menu"] = "ninguno";
}

<div class="auth">
    <aside class="auth-aside">
        <a class="brand" asp-controller="Home" asp-action="Index"><partial name="_Logo" />ISIRUN</a>
        <h1 class="display-xl">Bienvenido<br />de vuelta<span class="accent">.</span></h1>
        <p>Tus carreras, tu equipo y tus resultados te esperan.</p>
    </aside>
    <main class="auth-main">
        <form class="form auth-form" asp-controller="Cuenta" asp-action="Login" method="post">
            <h2 class="page-title">Entrar</h2>
            @* Muestra el error general: ModelState.AddModelError("", "Correo o contraseña incorrectos.") *@
            <div asp-validation-summary="ModelOnly"></div>

            <div class="field">
                <label for="email">Correo</label>
                <input id="email" name="email" type="email" class="input" autocomplete="username" placeholder="ana@correo.com" required />
            </div>
            <div class="field">
                <label for="contrasena">Contraseña</label>
                <input id="contrasena" name="contrasena" type="password" class="input" autocomplete="current-password" required />
            </div>

            <button type="submit" class="btn btn-dark btn-lg btn-block">Entrar</button>
            <p class="alert alert-info">Una sola entrada para corredores y organizaciones: te llevamos a tu panel según tu tipo de cuenta.</p>
            <p class="muted">¿No tienes cuenta? <a class="strong" asp-action="Registro">Regístrate</a></p>
        </form>
    </main>
</div>
