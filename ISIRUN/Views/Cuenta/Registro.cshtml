@model RegistroViewModel
@{
    ViewData["Title"] = "Crear cuenta";
    ViewData["Menu"] = "ninguno";
}

<div class="auth">
    <aside class="auth-aside">
        <a class="brand" asp-controller="Home" asp-action="Index"><partial name="_Logo" />ISIRUN</a>
        <h1 class="display-xl">Tu primer<br />kilómetro<br />empieza <span class="accent">aquí.</span></h1>
        <ul class="auth-perks">
            <li>✓ Inscríbete en carreras y sigue tu ranking</li>
            <li>✓ Únete a un equipo</li>
            <li>✓ ¿Organizas carreras? Crea una cuenta de organización</li>
        </ul>
    </aside>
    <main class="auth-main">
        <form class="form auth-form" asp-controller="Cuenta" asp-action="Registro" method="post">
            <h2 class="page-title">Crear cuenta</h2>
            <div asp-validation-summary="ModelOnly"></div>

            <fieldset class="plain">
                <legend>Tipo de cuenta</legend>
                <div class="grid-2">
                    <label>
                        <input class="chip-input" type="radio" name="Tipo" value="@Roles.Corredor" checked="@(Model.Tipo == Roles.Corredor)" />
                        <span class="option-card"><span class="strong">Corredor</span><span class="muted">Corro y me inscribo</span></span>
                    </label>
                    <label>
                        <input class="chip-input" type="radio" name="Tipo" value="@Roles.Organizacion" checked="@(Model.Tipo == Roles.Organizacion)" />
                        <span class="option-card"><span class="strong">Organización</span><span class="muted">Organizo carreras</span></span>
                    </label>
                </div>
            </fieldset>

            @* Campos solo de corredor (site.js oculta/deshabilita según el tipo elegido) *@
            <div class="form" data-tipo="@Roles.Corredor">
                <div class="field">
                    <label asp-for="Nombre">Nombre completo</label>
                    <input asp-for="Nombre" class="input" autocomplete="name" placeholder="Ana Rojas" required />
                    <span asp-validation-for="Nombre"></span>
                </div>
                <div class="row">
                    <div class="field">
                        <label asp-for="FechaNac">Fecha de nacimiento</label>
                        <input asp-for="FechaNac" type="date" class="input" required />
                        <span asp-validation-for="FechaNac"></span>
                    </div>
                    <div class="field">
                        <label asp-for="IdEquipo">Equipo <span class="muted">(opcional)</span></label>
                        <select asp-for="IdEquipo" asp-items="Model.Equipos" class="input">
                            <option value="">Sin equipo por ahora</option>
                        </select>
                        <span asp-validation-for="IdEquipo"></span>
                    </div>
                </div>
            </div>

            @* Campos solo de organización *@
            <div class="form" data-tipo="@Roles.Organizacion">
                <div class="field">
                    <label asp-for="NombreOrganizacion">Nombre de la organización</label>
                    <input asp-for="NombreOrganizacion" class="input" autocomplete="organization" placeholder="Club Atlético Norte" required />
                    <span asp-validation-for="NombreOrganizacion"></span>
                </div>
                <div class="field">
                    <label asp-for="Actividad">Actividad</label>
                    <input asp-for="Actividad" class="input" placeholder="Club deportivo, municipalidad, tienda…" required />
                    <span asp-validation-for="Actividad"></span>
                </div>
            </div>

            <div class="field">
                <label asp-for="Email">Correo</label>
                <input asp-for="Email" type="email" class="input" autocomplete="email" required />
                <span asp-validation-for="Email"></span>
            </div>
            <div class="row">
                <div class="field">
                    <label asp-for="Contrasena">Contraseña</label>
                    <input asp-for="Contrasena" type="password" class="input" autocomplete="new-password" minlength="8" required />
                    <span class="hint">Mínimo 8 caracteres.</span>
                    <span asp-validation-for="Contrasena"></span>
                </div>
                <div class="field">
                    <label asp-for="ConfirmarContrasena">Confirmar contraseña</label>
                    <input asp-for="ConfirmarContrasena" type="password" class="input" autocomplete="new-password" required />
                    <span asp-validation-for="ConfirmarContrasena"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-lime btn-lg btn-block">Crear cuenta</button>
            <p class="muted">¿Ya tienes cuenta? <a class="strong" asp-action="Login">Entrar</a></p>
        </form>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
