@model EquipoDetalleViewModel
@{
    ViewData["Title"] = Model.Nombre;
    ViewData["Nav"] = "equipos";
}

<main class="container">
    <a class="back-link" asp-action="Index">← Todos los equipos</a>
    <section class="hero-card">
        <span class="tile lime xl">@Model.Iniciales</span>
        <div class="grow stack tight">
            <h1 class="page-title">@Model.Nombre</h1>
            <p class="sub">Creado el @Formatos.FechaCorta(Model.FechaCreacion)</p>
        </div>
        @if (Model.SoyMiembro)
        {
            <form asp-action="Salir" asp-route-id="@Model.Id" method="post" class="stack tight">
                <span class="badge badge-lime">Eres miembro</span>
                <button type="submit" class="btn btn-on-dark">Salir del equipo</button>
            </form>
        }
        else
        {
            <form asp-action="Unirse" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-lime btn-lg">Unirme al equipo</button>
            </form>
        }
    </section>

    <section class="stats" aria-label="Estadísticas del equipo">
        <div class="stat"><span class="label-upper">Miembros</span><span class="stat-value">@Model.TotalMiembros</span></div>
        <div class="stat"><span class="label-upper">Kms del equipo</span><span class="stat-value">@Formatos.Km(Model.KmsEquipo)</span></div>
        <div class="stat"><span class="label-upper">Podios</span><span class="stat-value">@Model.Podios</span></div>
    </section>

    <section class="card">
        <h2 class="section-title">Miembros</h2>
        <div class="table-wrap">
            <table class="table">
                <thead><tr><th scope="col">#</th><th scope="col">Corredor</th><th scope="col">Edad</th><th scope="col" class="num">Kms totales</th></tr></thead>
                <tbody>
                    @{ var pos = 1; }
                    @foreach (var m in Model.Miembros)
                    {
                        <tr>
                            <td class="rank">@(pos++)</td>
                            <td><a class="strong" asp-controller="Corredor" asp-action="Ver" asp-route-id="@m.Id">@m.Nombre</a></td>
                            <td class="muted">@m.Categoria</td>
                            <td class="num strong">@Formatos.Km(m.Kms)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</main>
