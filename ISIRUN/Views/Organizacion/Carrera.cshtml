@model GestionCarreraViewModel
@{
    ViewData["Title"] = "Gestionar carrera";
    ViewData["Menu"] = "org";
    ViewData["Nav"] = "panel";
}

<main class="container">
    <a class="back-link" asp-action="Panel">← Mis carreras</a>

    <section class="hero-card">
        <div class="grow stack">
            @if (Model.Terminada)
            {
                <span class="badge badge-light">Terminada</span>
            }
            else
            {
                <span class="badge badge-lime">Inscripción abierta</span>
            }
            <h1 class="page-title">@Model.Nombre</h1>
            <p class="sub">@Model.Detalle</p>
        </div>
        @if (!Model.Terminada)
        {
            <div class="row tight">
                @if (Model.EsCreadora)
                {
                    <a class="btn btn-on-dark" asp-action="EditarCarrera" asp-route-id="@Model.Id">Editar</a>
                }
                <a class="btn btn-on-dark" asp-action="Vinculos" asp-route-id="@Model.Id">Sponsors y co-organizadores</a>
                @if (Model.EsCreadora)
                {
                    <button type="button" class="btn btn-danger-on-dark" data-dialog-open="eliminar-carrera">Eliminar</button>
                    <button type="button" class="btn btn-lime" data-dialog-open="terminar-carrera">Terminar carrera</button>
                }
            </div>
        }
    </section>

    @if (!Model.Terminada && Model.EsCreadora)
    {
        <dialog id="terminar-carrera" class="confirm" aria-labelledby="terminar-t">
            <form class="stack" asp-action="TerminarCarrera" asp-route-id="@Model.Id" method="post">
                <h2 id="terminar-t" class="section-title">¿Terminar la carrera?</h2>
                <p>Se cierran las inscripciones y se generan los tiempos de los @Model.TotalInscritos inscritos para armar el ranking de cada categoría. Esta acción no se puede deshacer.</p>
                <p class="alert alert-info">Simulación: cada corredor recibe un ritmo aleatorio entre 4:00 y 8:00 min/km. En una carrera real los tiempos llegarían del chip de cronometraje.</p>
                <div class="form-actions">
                    <button type="button" class="btn btn-outline" data-dialog-close>Cancelar</button>
                    <button type="submit" class="btn btn-dark">Sí, terminar y generar ranking</button>
                </div>
            </form>
        </dialog>

        <dialog id="eliminar-carrera" class="confirm danger" aria-labelledby="eliminar-t">
            <form class="stack" asp-action="EliminarCarrera" asp-route-id="@Model.Id" method="post">
                <h2 id="eliminar-t" class="section-title">¿Eliminar esta carrera?</h2>
                <p>Se eliminarán la carrera, sus @Model.Categorias.Count categorías, los vínculos con sponsors y co-organizadores, y las @Model.TotalInscritos inscripciones. No se puede deshacer.</p>
                <div class="form-actions">
                    <button type="button" class="btn btn-outline" data-dialog-close>Cancelar</button>
                    <button type="submit" class="btn btn-danger">Sí, eliminar carrera</button>
                </div>
            </form>
        </dialog>
    }

    <section class="card">
        <div class="page-head">
            <h2 class="section-title">@(Model.Terminada ? "Ranking" : "Inscritos")</h2>
            <nav class="chips" aria-label="Categoría">
                @foreach (var c in Model.Categorias)
                {
                    <a class="chip sm @(c.Id == Model.CategoriaActual ? "active" : null)" aria-current="@(c.Id == Model.CategoriaActual ? "page" : null)" asp-route-id="@Model.Id" asp-route-categoria="@c.Id">@c.Rango · @c.Inscritos</a>
                }
            </nav>
        </div>
        <div class="table-wrap">
            <table class="table">
                <thead><tr><th scope="col">Pos.</th><th scope="col">Corredor</th><th scope="col">Equipo</th><th scope="col">Tiempo</th><th scope="col">Ritmo</th></tr></thead>
                <tbody>
                    @foreach (var f in Model.Filas)
                    {
                        <tr>
                            <td class="rank">@(f.Ranking?.ToString() ?? "—")</td>
                            <td class="strong">@f.Corredor</td>
                            <td class="muted">@f.Equipo</td>
                            <td>
                                @if (f.Tiempo is null)
                                {
                                    <span class="badge badge-pending">Pendiente</span>
                                }
                                else
                                {
                                    <strong class="nums">@f.Tiempo</strong>
                                }
                            </td>
                            <td class="muted nums">@(f.Ritmo is null ? "—" : f.Ritmo + " /km")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.Filas.Count == 0)
        {
            <p class="empty">No hay corredores inscritos en esta categoría.</p>
        }
    </section>
</main>
