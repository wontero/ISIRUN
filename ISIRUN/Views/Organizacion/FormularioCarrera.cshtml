@model CarreraFormViewModel
@{
    // Misma vista para Crear y Editar (el controlador pone ViewData["Editando"] = true al editar).
    var editando = ViewData["Editando"] is true;
    ViewData["Title"] = editando ? "Editar carrera" : "Crear carrera";
    ViewData["Menu"] = "org";
    ViewData["Nav"] = editando ? "panel" : "crear";
}

<main class="container narrow">
    <a class="back-link" asp-action="Panel">← Mis carreras</a>
    <h1 class="page-title">@ViewData["Title"]</h1>

    @* Los inputs de categorías se llaman Categorias[0].EdadMinima, Categorias[1].EdadMinima, ...
       así el model binding arma la lista sola. *@
    <form class="form" asp-action="@(editando ? "EditarCarrera" : "CrearCarrera")" asp-route-id="@(editando ? Model.IdCarrera.ToString() : null)" method="post">
        <div asp-validation-summary="ModelOnly"></div>

        <fieldset class="card lg form">
            <legend class="section-title">Datos de la carrera</legend>
            <div class="field">
                <label asp-for="Nombre">Nombre</label>
                <input asp-for="Nombre" class="input" placeholder="Ej. 10K Nocturna del Parque" maxlength="150" required />
                <span asp-validation-for="Nombre"></span>
            </div>
            <div class="row">
                <div class="field">
                    <label asp-for="Distancia">Distancia (km)</label>
                    <input asp-for="Distancia" type="number" min="0.1" step="0.1" class="input" placeholder="10" required />
                    <span asp-validation-for="Distancia"></span>
                </div>
                <div class="field">
                    <label asp-for="PrecioInscripcion">Precio de inscripción</label>
                    <input asp-for="PrecioInscripcion" type="number" min="0" step="0.01" class="input" placeholder="15.00" required />
                    <span asp-validation-for="PrecioInscripcion"></span>
                </div>
                <div class="field">
                    <label asp-for="Fecha">Fecha y hora</label>
                    <input asp-for="Fecha" type="datetime-local" class="input" required />
                    <span asp-validation-for="Fecha"></span>
                </div>
                <div class="field">
                    <label asp-for="TamanoEquipo">Personas en tu equipo organizador</label>
                    <input asp-for="TamanoEquipo" type="number" min="1" class="input" placeholder="25" required />
                    <span asp-validation-for="TamanoEquipo"></span>
                </div>
            </div>
        </fieldset>

        <fieldset class="card lg form">
            <legend class="section-title">Categorías por edad</legend>
            <p class="muted small">Toda carrera necesita al menos una categoría y los rangos no pueden superponerse. Los corredores se ubican solos según su edad.</p>
            @for (var i = 0; i < Model.Categorias.Count; i++)
            {
                <div class="cat-row">
                    <input type="hidden" asp-for="Categorias[i].IdCategoria" />
                    <span class="section-title muted">@(i + 1)</span>
                    <div class="field fixed">
                        <label asp-for="Categorias[i].EdadMinima">Edad mínima</label>
                        <input asp-for="Categorias[i].EdadMinima" type="number" min="0" max="150" class="input sm" required />
                        <span asp-validation-for="Categorias[i].EdadMinima"></span>
                    </div>
                    <div class="field fixed">
                        <label asp-for="Categorias[i].EdadMaxima">Edad máxima</label>
                        <input asp-for="Categorias[i].EdadMaxima" type="number" min="0" max="150" class="input sm" required />
                        <span asp-validation-for="Categorias[i].EdadMaxima"></span>
                    </div>
                    <div class="field wide">
                        <label asp-for="Categorias[i].Premios">Premios</label>
                        <input asp-for="Categorias[i].Premios" class="input sm" placeholder="1.º: $100; 2.º: $50; 3.º: medalla" />
                        <span asp-validation-for="Categorias[i].Premios"></span>
                    </div>
                    @* Quitar y Agregar mandan el formulario sin validar: el controlador cambia las filas y lo vuelve a mostrar. *@
                    <button type="submit" name="QuitarCategoria" value="@i" formnovalidate class="btn btn-danger-outline btn-sm" aria-label="Quitar categoría @(i + 1)">Quitar</button>
                </div>
            }
            <button type="submit" name="AgregarCategoria" value="1" formnovalidate class="btn btn-dashed">+ Agregar categoría</button>
        </fieldset>

        <div class="form-actions">
            <a class="btn btn-outline btn-lg" asp-action="@(editando ? "Carrera" : "Panel")" asp-route-id="@(editando ? Model.IdCarrera.ToString() : null)">Cancelar</a>
            <button type="submit" class="btn btn-dark btn-lg">@(editando ? "Guardar cambios" : "Crear carrera")</button>
        </div>
    </form>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
