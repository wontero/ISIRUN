@model PanelOrganizacionViewModel
@{
    ViewData["Title"] = "Mis carreras";
    ViewData["Menu"] = "org";
    ViewData["Nav"] = "panel";
}

<main class="container">
    <div class="page-head">
        <div>
            <p class="muted strong">@Model.Nombre · @Model.Actividad</p>
            <h1 class="page-title">Mis carreras</h1>
        </div>
        <a class="btn btn-lime btn-lg" asp-action="CrearCarrera">+ Crear carrera</a>
    </div>

    <section class="stats" aria-label="Resumen">
        <div class="stat dark"><span class="label-upper">Abiertas</span><span class="stat-value">@Model.Abiertas.Count</span></div>
        <div class="stat"><span class="label-upper">Inscritos en abiertas</span><span class="stat-value">@Model.InscritosEnAbiertas</span></div>
        <div class="stat"><span class="label-upper">Terminadas</span><span class="stat-value">@Model.Terminadas.Count</span></div>
    </section>

    <section class="card" aria-labelledby="abiertas-t">
        <h2 id="abiertas-t" class="section-title">Abiertas</h2>
        @foreach (var c in Model.Abiertas)
        {
            <div class="list-item">
                <span class="tile dark lg">@c.Distancia</span>
                <span class="info"><span class="strong">@c.Nombre</span><span class="muted small">@c.Fecha · @c.Rol</span></span>
                <span class="stack tight"><span class="metric-value">@c.Inscritos</span><span class="muted xsmall">inscritos</span></span>
                <a class="btn btn-dark" asp-action="Carrera" asp-route-id="@c.Id">Gestionar</a>
            </div>
        }
        @if (Model.Abiertas.Count == 0)
        {
            <p class="empty">No tienes carreras abiertas. ¡Crea la primera!</p>
        }
    </section>

    <section class="card" aria-labelledby="terminadas-t">
        <h2 id="terminadas-t" class="section-title">Terminadas</h2>
        @foreach (var c in Model.Terminadas)
        {
            <div class="list-item soft">
                <span class="tile lg">@c.Distancia</span>
                <span class="info"><span class="strong">@c.Nombre</span><span class="muted small">@c.Fecha · Ganador: @c.Ganador</span></span>
                <a class="btn btn-outline" asp-action="Carrera" asp-route-id="@c.Id">Ver ranking</a>
            </div>
        }
        @if (Model.Terminadas.Count == 0)
        {
            <p class="empty">Todavía no terminaste ninguna carrera.</p>
        }
    </section>
</main>
