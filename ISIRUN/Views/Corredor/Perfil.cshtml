@model PerfilViewModel
@{
    ViewData["Title"] = "Mi perfil";
    ViewData["Nav"] = "perfil";
}

<main class="container">
    <section class="hero-card">
        <span class="avatar xl">@Model.Iniciales</span>
        <div class="grow stack tight">
            <h1 class="page-title">@Model.Nombre</h1>
            <p class="sub">Corredor desde @Formatos.MesAnio(Model.FechaRegistro) · @Model.Edad años</p>
            @if (Model.IdEquipo != null)
            {
                <a class="btn btn-on-dark btn-sm" asp-controller="Equipos" asp-action="Detalle" asp-route-id="@Model.IdEquipo">@Model.Equipo</a>
            }
            else
            {
                <a class="btn btn-on-dark btn-sm" asp-controller="Equipos" asp-action="Index">Sin equipo · buscar uno</a>
            }
        </div>
        <a class="btn btn-lime btn-lg" asp-controller="Actividades" asp-action="Crear">+ Registrar actividad</a>
    </section>

    <section class="stats" aria-label="Estadísticas">
        <div class="stat"><span class="label-upper">Kms totales</span><span class="stat-value">@Formatos.Km(Model.KmsTotales)<small>km</small></span></div>
        <div class="stat"><span class="label-upper">Carreras corridas</span><span class="stat-value">@Model.CarrerasCorridas</span></div>
        <div class="stat"><span class="label-upper">Mejor ranking</span><span class="stat-value">@(Model.MejorRanking.HasValue ? $"#{Model.MejorRanking}" : "—")</span></div>
        <div class="stat"><span class="label-upper">Actividades</span><span class="stat-value">@Model.TotalActividades</span></div>
    </section>

    <div class="split">
        <div class="split-main stack">
            <section class="card">
                <div class="page-head">
                    <h2 class="section-title">Mis inscripciones</h2>
                    <a class="small strong" asp-controller="Carreras" asp-action="Index">Buscar carreras</a>
                </div>
                @foreach (var i in Model.Inscripciones)
                {
                    <a class="list-item" asp-controller="Carreras" asp-action="Detalle" asp-route-id="@i.IdCarrera">
                        <span class="tile dark lg">@Formatos.DistanciaCorta(i.Distancia)</span>
                        <span class="info"><span class="strong">@i.Nombre</span><span class="muted small">@Formatos.FechaCorta(i.Fecha) · Cat. @i.Categoria</span></span>
                        <span class="badge badge-pending">Inscrito · pendiente</span>
                    </a>
                }
                @if (Model.Inscripciones.Count == 0)
                {
                    <p class="empty">No tienes inscripciones pendientes.</p>
                }
            </section>

            <section class="card">
                <h2 class="section-title">Mis resultados</h2>
                <div class="table-wrap">
                    <table class="table">
                        <thead><tr><th scope="col">Carrera</th><th scope="col">Categoría</th><th scope="col">Tiempo</th><th scope="col">Ranking</th></tr></thead>
                        <tbody>
                            @foreach (var r in Model.Resultados)
                            {
                                <tr>
                                    <td><a class="strong" asp-controller="Carreras" asp-action="Resultados" asp-route-id="@r.IdCarrera">@r.Carrera</a></td>
                                    <td class="muted">@r.Categoria</td>
                                    <td class="nums">@IsirunHelpers.FormatoTiempo(r.Tiempo)</td>
                                    <td class="rank">#@r.Ranking</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (Model.Resultados.Count == 0)
                {
                    <p class="empty">Todavía no corriste ninguna carrera terminada.</p>
                }
            </section>
        </div>

        <section class="card split-side">
            <h2 class="section-title">Últimas actividades</h2>
            <div>
                @foreach (var a in Model.Actividades)
                {
                    <div class="activity">
                        <div class="row center"><span class="strong grow">@a.Nombre</span><span class="muted xsmall">@Formatos.FechaRelativa(a.Fecha)</span></div>
                        <div class="activity-meta">
                            <span><strong>@Formatos.Km(a.Km)</strong> km</span><span><strong>@IsirunHelpers.FormatoTiempo(a.Tiempo)</strong></span><span>@a.Tipo</span><span>♥ @a.Likes</span>
                        </div>
                        <div class="row tight xsmall">
                            <a class="strong" asp-controller="Actividades" asp-action="Editar" asp-route-id="@a.Id">Editar</a>
                            <button type="button" class="btn-link danger" data-dialog-open="eliminar-actividad-@a.Id">Eliminar</button>
                        </div>
                        <dialog id="eliminar-actividad-@a.Id" class="confirm danger" aria-labelledby="eliminar-actividad-@a.Id-t">
                            <form class="stack" asp-controller="Actividades" asp-action="Eliminar" asp-route-id="@a.Id" method="post">
                                <h2 id="eliminar-actividad-@a.Id-t" class="section-title">¿Eliminar actividad?</h2>
                                <p>Se eliminará «@a.Nombre» y se restarán @Formatos.Km(a.Km) km de tu total. No se puede deshacer.</p>
                                <div class="form-actions">
                                    <button type="button" class="btn btn-outline" data-dialog-close>Cancelar</button>
                                    <button type="submit" class="btn btn-danger">Sí, eliminar</button>
                                </div>
                            </form>
                        </dialog>
                    </div>
                }
                @if (Model.Actividades.Count == 0)
                {
                    <p class="empty">Aún no registraste actividades.</p>
                }
            </div>
        </section>
    </div>
</main>
