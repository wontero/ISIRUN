@model ReporteRendimientoViewModel
@{
    ViewData["Title"] = "Reporte de rendimiento";
    ViewData["Menu"] = "org";
    ViewData["Nav"] = "reportes";
    var porEquipo = Model.PorEquipo;
}

<main class="container">
    <partial name="_NavReportes" />

    <div class="page-head">
        <div>
            <h1 class="page-title">Rendimiento</h1>
            <p class="muted">Tiempos y podios de una carrera terminada, agrupados por categoría de edad o por equipo.</p>
        </div>
        <button type="button" class="btn btn-outline no-print" onclick="window.print()">Imprimir</button>
    </div>

    <form class="filter-bar" method="get" asp-action="Rendimiento">
        <div class="field wide">
            <label for="carrera">Carrera terminada</label>
            <select id="carrera" name="carrera" class="input sm">
                @foreach (var c in Model.Carreras)
                {
                    <option value="@c.Id" selected="@(c.Id == Model.CarreraSeleccionada)">@c.Nombre</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="agrupar">Agrupar por</label>
            <select id="agrupar" name="agrupar" class="input sm">
                <option value="categoria" selected="@(!porEquipo)">Categoría</option>
                <option value="equipo" selected="@porEquipo">Equipo</option>
            </select>
        </div>
        <button type="submit" class="btn btn-dark">Ver reporte</button>
    </form>

    @if (Model.CarreraSeleccionada is null)
    {
        <p class="empty">Todavía no tienes carreras terminadas. El reporte aparece cuando terminas una carrera.</p>
    }
    else
    {
        <section class="stats" aria-label="Resumen">
            <div class="stat"><span class="label-upper">Finalistas</span><span class="stat-value">@Model.TotalFinalistas</span></div>
            <div class="stat dark"><span class="label-upper">Mejor tiempo</span><span class="stat-value">@Model.MejorTiempo</span><span class="muted xsmall">@Model.MejorNombre</span></div>
            <div class="stat"><span class="label-upper">Tiempo promedio</span><span class="stat-value">@Model.TiempoPromedio</span></div>
            <div class="stat"><span class="label-upper">Ritmo promedio</span><span class="stat-value">@Model.RitmoPromedio /km</span></div>
        </section>

        <section class="card" aria-labelledby="tabla-t">
            <h2 id="tabla-t" class="section-title">@(porEquipo ? "Por equipo" : "Por categoría") · @Model.NombreCarrera</h2>
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th scope="col">@(porEquipo ? "Equipo" : "Categoría")</th>
                            <th scope="col" class="num">Finalistas</th>
                            <th scope="col" class="num">Podios</th>
                            <th scope="col">Mejor tiempo</th>
                            <th scope="col">Tiempo promedio</th>
                            <th scope="col">Ritmo promedio</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in Model.Filas)
                        {
                            <tr>
                                <th scope="row">@f.Grupo</th>
                                <td class="num">@f.Finalistas</td>
                                <td class="num strong">@f.Podios</td>
                                <td class="nums">@f.MejorTiempo <span class="muted xsmall">@f.MejorNombre</span></td>
                                <td class="nums">@f.TiempoPromedio</td>
                                <td class="nums muted">@f.Ritmo /km</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th scope="row">Total</th>
                            <td class="num">@Model.TotalFinalistas</td>
                            <td class="num">@Model.TotalPodios</td>
                            <td class="nums">@Model.MejorTiempo</td>
                            <td class="nums">@Model.TiempoPromedio</td>
                            <td class="nums">@Model.RitmoPromedio /km</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            @if (Model.Filas.Count == 0)
            {
                <p class="empty">Esta carrera terminó sin corredores inscritos.</p>
            }
            <p class="muted xsmall">Podios: corredores en los 3 primeros puestos de su categoría. Solo incluye carreras terminadas.</p>
        </section>
    }
</main>
