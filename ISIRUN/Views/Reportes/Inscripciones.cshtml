@model ReporteInscripcionesViewModel
@{
    ViewData["Title"] = "Reporte de inscripciones y recaudación";
    ViewData["Menu"] = "org";
    ViewData["Nav"] = "reportes";
    var estado = Model.Estado;
}

<main class="container">
    <partial name="_NavReportes" />

    <div class="page-head">
        <div>
            <h1 class="page-title">Inscripciones y recaudación</h1>
            <p class="muted">Cuántos corredores se inscribieron en tus carreras, en qué categorías y cuánto se recaudó.</p>
        </div>
        <button type="button" class="btn btn-outline no-print" onclick="window.print()">Imprimir</button>
    </div>

    <form class="filter-bar" method="get" asp-action="Inscripciones">
        <div class="field">
            <label for="desde">Desde</label>
            <input id="desde" name="desde" type="date" class="input sm" value="@Model.Desde?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="field">
            <label for="hasta">Hasta</label>
            <input id="hasta" name="hasta" type="date" class="input sm" value="@Model.Hasta?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="field">
            <label for="estado">Estado</label>
            <select id="estado" name="estado" class="input sm">
                <option value="" selected="@(string.IsNullOrEmpty(estado))">Todas</option>
                <option value="Abierta" selected="@(estado == "Abierta")">Abiertas</option>
                <option value="Terminada" selected="@(estado == "Terminada")">Terminadas</option>
            </select>
        </div>
        <button type="submit" class="btn btn-dark">Filtrar</button>
        <a class="btn btn-outline" asp-action="Inscripciones">Limpiar</a>
    </form>

    <section class="stats" aria-label="Resumen">
        <div class="stat"><span class="label-upper">Carreras</span><span class="stat-value">@Model.Filas.Count</span></div>
        <div class="stat"><span class="label-upper">Inscritos</span><span class="stat-value">@Model.TotalInscritos</span></div>
        <div class="stat dark"><span class="label-upper">Recaudación total</span><span class="stat-value">@Presentacion.Monto(Model.TotalRecaudado)</span></div>
        <div class="stat"><span class="label-upper">Promedio por carrera</span><span class="stat-value">@Presentacion.Monto(Model.PromedioPorCarrera)</span></div>
    </section>

    <div class="split">
        <section class="card split-main" aria-labelledby="det-t">
            <h2 id="det-t" class="section-title">Detalle por carrera</h2>
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th scope="col">Carrera</th><th scope="col">Fecha</th><th scope="col">Estado</th>
                            @foreach (var r in Model.Rangos) { <th scope="col" class="num">@r</th> }
                            <th scope="col" class="num">Inscritos</th><th scope="col" class="num">Recaudado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in Model.Filas)
                        {
                            <tr>
                                <th scope="row">@f.Carrera</th>
                                <td class="muted">@Formatos.FechaCorta(f.Fecha)</td>
                                <td>@f.Estado</td>
                                @foreach (var n in f.InscritosPorRango) { <td class="num">@n</td> }
                                <td class="num strong">@f.Inscritos</td>
                                <td class="num strong">@Presentacion.Monto(f.Recaudado)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th scope="row" colspan="3">Total</th>
                            @foreach (var t in Model.TotalesPorCategoria) { <td class="num">@t.Inscritos</td> }
                            <td class="num">@Model.TotalInscritos</td>
                            <td class="num">@Presentacion.Monto(Model.TotalRecaudado)</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            @if (Model.Filas.Count == 0)
            {
                <p class="empty">No hay carreras en ese período.</p>
            }
        </section>

        <section class="card split-side" aria-labelledby="cat-t">
            <h2 id="cat-t" class="section-title">Inscritos por categoría</h2>
            @foreach (var b in Model.TotalesPorCategoria)
            {
                <div class="stack tight">
                    <div class="row center small"><span class="strong grow">@b.Rango</span><span class="nums"><strong>@b.Inscritos</strong> · @b.Participacion%</span></div>
                    @* Única excepción a "nada de style=": el ancho de la barra es un dato calculado. *@
                    <div class="bar"><span style="width: @b.PorcentajeBarra%"></span></div>
                </div>
            }
        </section>
    </div>
</main>
